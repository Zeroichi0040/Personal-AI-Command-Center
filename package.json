{
  "name": "personal-ai-command-center",
  "version": "0.1.0-dev.4",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "start": "node apps/server/src/index.mjs",
    "dev": "npm run build && npm start"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.0"
  }
}
